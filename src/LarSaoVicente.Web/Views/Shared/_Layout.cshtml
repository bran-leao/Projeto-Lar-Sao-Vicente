@using LarSaoVicente.Infrastructure.Identity
@{
    var controllerAtual = ViewContext.RouteData.Values["controller"]?.ToString();
    var nomeUsuario = User.FindFirst(ApplicationUserClaimsPrincipalFactory.FullNameClaimType)?.Value
                      ?? User.Identity?.Name
                      ?? string.Empty;

    string LinkAtivo(string controller) =>
        string.Equals(controllerAtual, controller, StringComparison.OrdinalIgnoreCase) ? "ativo" : string.Empty;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] &middot; Lar São Vicente de Paulo</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">

        @* Em telas grandes a barra lateral fica fixa; abaixo de 992px vira um painel deslizante. *@
        <nav class="app-sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="menuLateral"
             aria-label="Menu principal">
            <div class="offcanvas-body">
                @*
                    O conteúdo fica em um painel próprio porque o Bootstrap aplica
                    background-color: transparent !important tanto no .offcanvas-lg quanto
                    no .offcanvas-body acima do breakpoint. Pintar um elemento nosso evita
                    ter de recorrer a !important para vencer essa regra.
                *@
                <div class="app-sidebar__painel">
                <div class="app-marca">
                    <a class="app-marca__nome" asp-controller="Dashboard" asp-action="Index">
                        Lar São Vicente de Paulo
                    </a>
                    <div class="app-marca__subtitulo">Sistema de Gestão</div>
                </div>

                <div class="app-nav">
                    <div class="app-nav__titulo">Menu</div>
                    <a class="app-nav__link @LinkAtivo("Dashboard")"
                       asp-controller="Dashboard" asp-action="Index">
                        Dashboard
                    </a>
                    <a class="app-nav__link @LinkAtivo("Residents")"
                       asp-controller="Residents" asp-action="Index">
                        Residentes
                    </a>
                </div>
                </div>
            </div>
        </nav>

        <div class="app-conteudo">
            <header class="app-topo">
                <button class="btn btn-outline-secondary btn-sm d-lg-none" type="button"
                        data-bs-toggle="offcanvas" data-bs-target="#menuLateral"
                        aria-controls="menuLateral" aria-label="Abrir menu">
                    Menu
                </button>

                <h1 class="app-topo__titulo">@ViewData["Title"]</h1>

                <div class="ms-auto d-flex align-items-center gap-3">
                    <div class="app-topo__usuario d-none d-sm-block">
                        <strong>@nomeUsuario</strong>
                        Funcionário autenticado
                    </div>
                    <form asp-controller="Account" asp-action="Sair" method="post">
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Sair</button>
                    </form>
                </div>
            </header>

            <main class="app-principal">
                <partial name="_Mensagens" />
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
