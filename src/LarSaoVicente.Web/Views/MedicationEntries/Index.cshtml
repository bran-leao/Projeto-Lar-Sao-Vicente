@model IReadOnlyList<MedicationEntryListItemViewModel>

<p class="text-secondary">
    O estoque é a soma das entradas conferidas. Enquanto uma remessa estiver nesta lista,
    ela está registrada mas <strong>não conta no estoque</strong> e não deve ser usada.
</p>

<div class="cartao">
    <div class="cartao__cabecalho">Aguardando conferência</div>

    @if (Model.Count == 0)
    {
        <div class="cartao__corpo estado-vazio">
            <p class="estado-vazio__titulo">Nada pendente</p>
            <p class="mb-3">Todas as entradas registradas já foram revisadas.</p>
            <a class="btn btn-outline-secondary btn-sm" asp-controller="Medications" asp-action="Index">
                Ir para o catálogo
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table tabela-dados align-middle mb-0">
                <caption class="visually-hidden">Entradas aguardando conferência</caption>
                <thead>
                    <tr>
                        <th scope="col">Item</th>
                        <th scope="col" class="text-end">Quantidade</th>
                        <th scope="col">Lote</th>
                        <th scope="col">Validade</th>
                        <th scope="col">Origem</th>
                        <th scope="col">Recebido em</th>
                        <th scope="col"><span class="visually-hidden">Ações</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entrada in Model)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Medications" asp-action="Detalhes"
                                   asp-route-id="@entrada.MedicationId"
                                   class="text-decoration-none fw-semibold">@entrada.NomeDoMedicamento</a>
                                @if (entrada.PorLeitura)
                                {
                                    <span class="badge text-bg-light border ms-1">Por leitura</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-light border ms-1">Digitada</span>
                                }
                            </td>
                            <td class="text-end fw-semibold">@entrada.Quantity</td>
                            <td>@(string.IsNullOrWhiteSpace(entrada.LotNumber) ? "—" : entrada.LotNumber)</td>
                            <td>
                                @if (entrada.ValidadeNaoIdentificada)
                                {
                                    <span class="badge text-bg-warning">Não identificada</span>
                                }
                                else if (entrada.Vencido)
                                {
                                    <span class="badge text-bg-danger">Vencido em @entrada.Validade</span>
                                }
                                else
                                {
                                    @entrada.Validade
                                }
                            </td>
                            <td>@entrada.Origin.ObterNomeExibicao()</td>
                            <td>@entrada.Recebimento</td>
                            <td class="text-end">
                                @* Os botões quebram em mais de uma linha quando a
                                   tela é estreita. É proposital: com a coluna fixa em
                                   uma linha só, "Recusar" sai da área visível, e uma
                                   ação escondida é pior do que uma linha mais alta. *@
                                <div class="d-flex gap-2 justify-content-end flex-wrap">
                                    <a class="btn btn-outline-secondary btn-sm"
                                       asp-action="Editar" asp-route-id="@entrada.Id">Corrigir</a>

                                    <form method="post" asp-action="Conferir" asp-route-id="@entrada.Id"
                                          onsubmit="return confirm('Liberar @entrada.Quantity unidade(s) de @entrada.NomeDoMedicamento para o estoque?');">
                                        <button type="submit" class="btn btn-success btn-sm">Conferir</button>
                                    </form>

                                    <form method="post" asp-action="Recusar" asp-route-id="@entrada.Id"
                                          onsubmit="return pedirMotivo(this);">
                                        <input type="hidden" name="motivo" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Recusar</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="cartao__cabecalho border-top border-bottom-0 text-secondary fw-normal small">
            @Model.Count entrada(s) aguardando conferência.
            A entrada recusada não é apagada: fica registrada com o motivo.
        </div>
    }
</div>

@section Scripts {
    <script>
        // Único uso de JavaScript nesta tela: o motivo da recusa é obrigatório, e pedi-lo
        // aqui evita uma segunda página só para digitar uma frase. Se o script não rodar,
        // o motivo chega vazio e o servidor recusa a operação com a mensagem correta.
        function pedirMotivo(formulario) {
            var motivo = window.prompt('Qual o motivo da recusa?');

            if (motivo === null || motivo.trim() === '') {
                return false;
            }

            formulario.elements['motivo'].value = motivo;
            return true;
        }
    </script>
}
